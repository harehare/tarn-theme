  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7c3aed",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#475569"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#047857"
      }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.escape"],
      "settings": {
        "foreground": "#155e75"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "variable.interpolated",
        "variable.other.interpolated",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#7c3aed"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "constant.other.unit"
      ],
      "settings": {
        "foreground": "#c2410c"
      }
    },
    {
      "name": "Booleans and language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#075985"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": {
        "foreground": "#1e40af",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.declaration"
      ],
      "settings": {
        "foreground": "#1e40af"
      }
    },
    {
      "name": "Selectors and properties",
      "scope": [
        "entity.name.function.selector",
        "variable.other.property",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#155e75"
      }
    },
    {
      "name": "Symbols",
      "scope": ["constant.other.symbol"],
      "settings": {
        "foreground": "#075985"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Type annotations",
      "scope": ["entity.name.type.annotation", "support.type.primitive"],
      "settings": {
        "foreground": "#0369a1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Delimiters and punctuation",
      "scope": [
        "delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#475569"
      }
    },
    {
      "name": "Brackets and parentheses",
      "scope": [
        "delimiter.parenthesis",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#475569"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#a21caf"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#0e7490"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#0369a1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#0f172a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#0f172a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#047857"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#475569",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list bullets",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#0369a1"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#dc2626"
      }
    }
  ]
}
