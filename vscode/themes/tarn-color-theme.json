  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7e8fa6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#67b8e3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.operator"],
      "settings": {
        "foreground": "#a3b2c6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.interpolated"
      ],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "String escape sequences",
      "scope": ["constant.character.escape", "string.escape"],
      "settings": {
        "foreground": "#67e8f9"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "variable.interpolated",
        "variable.other.interpolated",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#67b8e3"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.other.color",
        "constant.other.unit"
      ],
      "settings": {
        "foreground": "#de935f"
      }
    },
    {
      "name": "Booleans and language constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#85d4ff"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.call",
        "support.function",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#56d4d4"
      }
    },
    {
      "name": "Function parameters",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": {
        "foreground": "#9cdcfe",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.declaration"
      ],
      "settings": {
        "foreground": "#9cdcfe"
      }
    },
    {
      "name": "Selectors and properties",
      "scope": [
        "entity.name.function.selector",
        "variable.other.property",
        "support.type.property-name",
        "meta.property-name"
      ],
      "settings": {
        "foreground": "#67e8f9"
      }
    },
    {
      "name": "Symbols",
      "scope": ["constant.other.symbol"],
      "settings": {
        "foreground": "#85d4ff"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#67b8e3"
      }
    },
    {
      "name": "Type annotations",
      "scope": ["entity.name.type.annotation", "support.type.primitive"],
      "settings": {
        "foreground": "#67b8e3",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Delimiters and punctuation",
      "scope": [
        "delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.block",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "#a3b2c6"
      }
    },
    {
      "name": "Brackets and parentheses",
      "scope": [
        "delimiter.parenthesis",
        "meta.brace",
        "punctuation.definition.parameters",
        "punctuation.definition.array"
      ],
      "settings": {
        "foreground": "#a3b2c6"
      }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#fc8181"
      }
    },
    {
      "name": "Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#56d4d4"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "foreground": "#67b8e3",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#e2e8f0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#e2e8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.raw.block"],
      "settings": {
        "foreground": "#89ddff"
      }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": {
        "foreground": "#67b8e3"
      }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#a3b2c6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown list bullets",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#67b8e3"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#fc8181"
      }
    }
  ]
}
